{
  "appId": "com.documate.app",
  "productName": "DocuMate",
  "directories": {
    "output": "../dist",
    "app": ".",
    "buildResources": "public"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json",
    "!**/node_modules/*"
  ],
  "extraResources": [
    {
      "from": "../Backend/target/Backend-0.0.1-SNAPSHOT.jar",
      "to": "backend.jar" 
    }
  ],
  "win": {
    "target": "nsis",
    "icon": "public/DocuMate.ico"
  },
  "mac": {
    "target": "dmg",
    "icon": "public/DocuMate.icns"
  },
  "linux": {
    "target": "AppImage",
    "icon": "public/DocuMate.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "installerIcon": "public/DocuMate.ico",
    "uninstallerIcon": "public/DocuMate.ico"
  },
  "asar": false
}