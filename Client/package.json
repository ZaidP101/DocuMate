{
  "name": "documate",
  "private": true,
  "version": "1.0.0",
  "description": "AI-Powered Documentation Automation Platform",
  "type": "commonjs", 
  "author": "Zaid Patel & Amir Khan",
  "main": "electron/main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite",
    "dev:electron": "cross-env NODE_ENV=development concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "cross-env NODE_ENV=production vite build",
    "preview": "vite preview",
    "electron:start": "cross-env NODE_ENV=production electron .",
    "electron:build": "npm run build && npm run electron:start",
    "package": "npm run build && electron-builder --config ./electron-builder.json --win"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/postcss": "^4.1.16",
    "autoprefixer": "^10.4.21",
    "axios": "^1.13.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.548.0",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.4",
    "react-toastify": "^11.0.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "vite": "^7.1.7",
    "wait-on": "^7.0.1"
  }
}
